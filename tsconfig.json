{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "core/**/*.ts",
    "app-electron/**/*.ts",
    "app-electron/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx"
  ],
  "exclude": ["shared/**/*.test.ts", "shared/**/*.test.tsx"]
}
